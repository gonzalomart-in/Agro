# Token del bot, obtenido de @BotFather en Telegram
TELEGRAM_BOT_TOKEN=8988

# Cadena de conexión a PostgreSQL
DATABASE_URL=postgresql://agro:agro@postgres:5432/agro

# Ollama
OLLAMA_HOST=http://ollama:11434
# Modelo recomendado para PRODUCCIÓN (ej. la VM Always Free de Oracle Cloud, que
# tiene RAM de sobra): mucho más preciso extrayendo los datos de la recorrida.
# Si estás probando en una PC con poca RAM (<=8GB), usá qwen2.5:3b en su lugar
# (más liviano, pero bastante menos preciso: puede dejar campos en null aunque
# se hayan dicho, ver README).
OLLAMA_MODEL=qwen2.5:7b

# faster-whisper: base (liviano), small o medium (más precisión, más RAM/CPU)
WHISPER_MODEL=base

# IDs de Telegram (separados por coma) que arrancan como administradores.
# Un administrador puede invitar/revocar acceso a otros usuarios con /invitar y /revocar.
ADMIN_USER_IDS=
